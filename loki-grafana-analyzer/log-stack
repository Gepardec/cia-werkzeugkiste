#!/bin/sh
set -eu

cd "$(dirname "$0")"

compose_loki() {
  docker compose -f docker-compose.yaml -f docker-compose.loki.yaml "$@"
}

compose_victorialogs() {
  docker compose -f docker-compose.yaml -f docker-compose.victorialogs.yaml "$@"
}

compose_victorialogs_json() {
  docker compose -f docker-compose.yaml -f docker-compose.victorialogs-json.yaml "$@"
}

loki_diagnostics() {
  printf '%s\n' 'Loki service state:'
  compose_loki ps --all || true
  printf '%s\n' 'Recent Loki logs:'
  docker logs --tail 80 loki 2>&1 || true
  printf '%s\n' 'Recent Alloy logs:'
  docker logs --tail 80 alloy 2>&1 || true
}

check_loki() {
  if ! command -v curl >/dev/null 2>&1; then
    printf '%s\n' 'curl is required for Loki connection checks.' >&2
    return 1
  fi

  if ! curl --fail --silent --show-error --max-time 5 \
    http://127.0.0.1:3100/services >/dev/null; then
    printf '%s\n' 'Loki service check failed.' >&2
    loki_diagnostics >&2
    return 1
  fi

  if ! curl --fail --silent --show-error --max-time 10 --get \
    --data-urlencode 'query={job="local_logs"}' \
    --data-urlencode 'start=0' \
    --data-urlencode 'limit=1' \
    http://127.0.0.1:3100/loki/api/v1/query_range >/dev/null; then
    printf '%s\n' 'Loki services respond, but the LogQL query endpoint failed.' >&2
    loki_diagnostics >&2
    return 1
  fi

  printf '%s\n' 'Loki service and LogQL query checks passed.'
}

victorialogs_diagnostics() {
  printf '%s\n' 'VictoriaLogs service state:'
  compose_victorialogs_json ps --all || true
  printf '%s\n' 'Recent VictoriaLogs logs:'
  docker logs --tail 80 victorialogs 2>&1 || true
  printf '%s\n' 'Recent Alloy logs:'
  docker logs --tail 80 alloy 2>&1 || true
}

check_victorialogs() {
  if ! command -v curl >/dev/null 2>&1; then
    printf '%s\n' 'curl is required for VictoriaLogs connection checks.' >&2
    return 1
  fi

  if ! curl --fail --silent --show-error --max-time 5 \
    http://127.0.0.1:9428/-/healthy >/dev/null; then
    printf '%s\n' 'VictoriaLogs health check failed.' >&2
    victorialogs_diagnostics >&2
    return 1
  fi

  if ! curl --fail --silent --show-error --max-time 10 --get \
    --data-urlencode 'query=*' \
    --data-urlencode 'start=0' \
    --data-urlencode 'limit=1' \
    http://127.0.0.1:9428/select/logsql/query >/dev/null; then
    printf '%s\n' 'VictoriaLogs is healthy, but the LogsQL query endpoint failed.' >&2
    victorialogs_diagnostics >&2
    return 1
  fi

  printf '%s\n' 'VictoriaLogs health and LogsQL query checks passed.'
}

usage() {
  cat <<'EOF'
Usage: ./log-stack <command>

Commands:
  loki                         Start Loki mode
  victorialogs                 Start VictoriaLogs structured/mixed mode
  vl                           Alias for VictoriaLogs structured/mixed mode
  victorialogs-json            Alias for VictoriaLogs structured/mixed mode
  vl-json                      Alias for VictoriaLogs structured/mixed mode
  vlj                          Alias for VictoriaLogs structured/mixed mode
  victorialogs-raw             Start VictoriaLogs raw/non-JSON mode
  vl-raw                       Alias for VictoriaLogs raw/non-JSON mode
  ps-loki                      Show Loki-mode container status
  ps-victorialogs              Show VictoriaLogs structured-mode container status
  ps-victorialogs-json         Alias for structured-mode container status
  ps-victorialogs-raw          Show VictoriaLogs raw-mode container status
  check-loki                   Check Loki services and LogQL queries
  check-victorialogs           Check VictoriaLogs health and LogsQL queries
  down                         Stop the active stack
  config-loki                  Validate Loki compose config
  config-victorialogs          Validate VictoriaLogs structured compose config
  config-victorialogs-json     Alias for structured compose validation
  config-victorialogs-raw      Validate VictoriaLogs raw compose config
  reset                        Reset all Loki/VictoriaLogs data and positions
EOF
}

remove_volume() {
  docker volume rm "$1" 2>/dev/null || true
}

command="${1:-help}"

case "$command" in
  loki)
    compose_loki up -d --remove-orphans
    ;;
  victorialogs|vl|victorialogs-json|vl-json|vlj)
    compose_victorialogs_json up -d --remove-orphans
    ;;
  victorialogs-raw|vl-raw)
    compose_victorialogs up -d --remove-orphans
    ;;
  ps-loki)
    compose_loki ps --all
    ;;
  ps-victorialogs|ps-victorialogs-json)
    compose_victorialogs_json ps --all
    ;;
  ps-victorialogs-raw)
    compose_victorialogs ps --all
    ;;
  check-loki)
    check_loki
    ;;
  check-victorialogs)
    check_victorialogs
    ;;
  down)
    compose_loki down --remove-orphans
    compose_victorialogs down --remove-orphans
    compose_victorialogs_json down --remove-orphans
    ;;
  config-loki)
    compose_loki config
    ;;
  config-victorialogs|config-victorialogs-json)
    compose_victorialogs_json config
    ;;
  config-victorialogs-raw)
    compose_victorialogs config
    ;;
  reset)
    compose_loki down --remove-orphans
    compose_victorialogs down --remove-orphans
    compose_victorialogs_json down --remove-orphans
    remove_volume loki-grafana-log-analysis_loki-data
    remove_volume loki-grafana-log-analysis_alloy-data
    remove_volume loki-grafana-log-analysis_victorialogs-data
    remove_volume loki-grafana-log-analysis_alloy-data-victorialogs
    remove_volume loki-grafana-log-analysis_alloy-data-victorialogs-json
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
